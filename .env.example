# ==============================================================================
# FoodRush Microservices - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.dev, .env.qa, or .env.prod and update the values.

# --- Global / Environment Meta ---
ENVIRONMENT=dev                        # dev | qa | prod
DEBUG=True                             # True for dev/qa, False for prod
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=food_delivery
MYSQL_USER=fooduser
MYSQL_PASSWORD=foodpassword
MYSQL_HOST=mysql-service               # Use 'localhost' for local, 'mysql-service' for Docker/K8s
MYSQL_PORT=3306

# --- JWT Authentication ---
JWT_SECRET=supersecretfooddeliveryjwtkey_change_in_production_2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 1440 mins = 24h (shorter in prod, e.g. 60)

# --- Microservice URLs (Internal Service Discovery) ---
AUTH_SERVICE_URL=http://auth-service:8000
BACKEND_SERVICE_URL=http://backend-service:8000

# --- Frontend & Ports ---
FRONTEND_PORT=3000
AUTH_PORT=8001
BACKEND_PORT=8002
K8S_NODEPORT=30080

# --- CORS & Hosts ---
ALLOWED_ORIGINS=*
INGRESS_HOST=foodrush.local

