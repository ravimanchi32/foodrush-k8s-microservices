# ==============================================================================
# PRODUCTION ENVIRONMENT (.env.prod)
# ==============================================================================
ENVIRONMENT=prod
DEBUG=False
LOG_LEVEL=WARNING

# --- MySQL Database (Production HA Cluster / Managed RDS / Cloud SQL) ---
# In production, credentials should be injected via Kubernetes Secrets / Vault / KMS
MYSQL_ROOT_PASSWORD=prod_vault_root_placeholder_rotate_regularly_98124
MYSQL_DATABASE=food_delivery_prod
MYSQL_USER=fooduser_prod
MYSQL_PASSWORD=prod_vault_password_placeholder_rotate_regularly_54321
MYSQL_HOST=mysql-service.foodrush-prod.svc.cluster.local
MYSQL_PORT=3306

# --- JWT Authentication (High Security - Short-lived Access Token) ---
JWT_SECRET=prod_CHANGEME_ENTER_SECURE_256BIT_HEX_OR_CRYPTOGRAPHIC_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60          # 1 hour for strict production security

# --- Inter-Service Routing (Production Cluster DNS) ---
AUTH_SERVICE_URL=http://auth-service.foodrush-prod.svc.cluster.local:8000
BACKEND_SERVICE_URL=http://backend-service.foodrush-prod.svc.cluster.local:8000

# --- Ports ---
FRONTEND_PORT=80
AUTH_PORT=8000
BACKEND_PORT=8000
K8S_NODEPORT=32080

# --- Web, TLS & Domain ---
ALLOWED_ORIGINS=https://foodrush.com,https://api.foodrush.com
INGRESS_HOST=foodrush.com

