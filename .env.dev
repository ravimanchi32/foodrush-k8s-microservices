# ==============================================================================
# DEVELOPMENT ENVIRONMENT (.env.dev)
# ==============================================================================
ENVIRONMENT=dev
DEBUG=True
LOG_LEVEL=DEBUG

# --- MySQL Database (Local / Docker Compose / Dev Cluster) ---
MYSQL_ROOT_PASSWORD=dev_root_secret_pass
MYSQL_DATABASE=food_delivery_dev
MYSQL_USER=fooduser_dev
MYSQL_PASSWORD=dev_food_password_123
MYSQL_HOST=mysql-service
MYSQL_PORT=3306

# --- JWT Authentication (Dev Key & Extended Token Expiration) ---
JWT_SECRET=dev_jwt_secret_key_antigravity_foodrush_2025_unsecure_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320        # 3 days for seamless development

# --- Inter-Service Routing ---
AUTH_SERVICE_URL=http://auth-service:8000
BACKEND_SERVICE_URL=http://backend-service:8000

# --- Ports (Dev exposed ports) ---
FRONTEND_PORT=3000
AUTH_PORT=8001
BACKEND_PORT=8002
K8S_NODEPORT=30080

# --- Web & CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INGRESS_HOST=dev.foodrush.local

